# 1. Jetons d'authentification API Incus 7.5 (affichés par playbook-hosts.yml à l'Étape 0)
export TF_VAR_incus_trust_token_hote_1="" # gitleaks:allow
export TF_VAR_incus_trust_token_hote_2="" # gitleaks:allow
export TF_VAR_incus_trust_token_hote_3="" # gitleaks:allow

# 2. Phrase secrète (min. 16 caractères) pour chiffrer le fichier terraform.tfstate (OpenTofu)
export TF_VAR_state_passphrase="$(openssl rand -base64 32)" # gitleaks:allow

# 3. GitHub Personal Access Token (droits "repo" pour FluxCD et Terraform)
# Ou la permission `Administration: Read and write` si un token `Fine-grained` est utilisé
export GITHUB_TOKEN="" # gitleaks:allow

# 4. Cloudflare API Token (droits Zone:Read et DNS:Edit pour Cert-Manager DNS-01)
export CLOUDFLARE_API_TOKEN="" # gitleaks:allow

